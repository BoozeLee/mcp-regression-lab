{
  "name": "mcp-regression-lab",
  "version": "1.0.0",
  "description": "Snapshot, diff and regression-test MCP tool contracts; local-model golden tests",
  "scripts": {
    "build": "tsc",
    "test": "node --test 'test/*.test.ts'",
    "lab": "node src/cli.ts",
    "desktop:dev": "cd desktop && cargo tauri dev",
    "desktop:build": "cd desktop && cargo tauri build --no-bundle",
    "desktop:package": "cd desktop && cargo tauri build --bundles appimage",
    "container:build": "./mcp-lab --build"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "typescript": "^6.0.3"
  },
  "private": true,
  "bin": {
    "mcp-lab": "src/cli.ts"
  },
  "workspaces": [
    "web"
  ]
}
